<div class="container py-5">

  <div class="row justify-content-center">
    <div class="col-lg-9">

      <article class="card border-0 shadow-lg blog-detail-card">

        <!-- Header -->
        <div class="card-header text-white text-center blog-header">
          <h1 class="fw-bold mb-0">{{blog.title}}</h1>
        </div>

        <!-- Content -->
        <div class="card-body p-4 p-md-5">

          <p class="blog-content fs-5 text-secondary">
            {{blog.content}}
          </p>

          <hr class="my-4">

          <!-- Back Button -->
          <div class="text-center">
            <a href="/blog" class="btn btn-outline-primary px-4">
              ← Back to Blogs
            </a>
          </div>

        </div>

      </article>

    </div>
  </div>

</div>

<!-- Optional styles for extra beauty -->
<style>
  .blog-header {
    background: linear-gradient(135deg, #667eea, #764ba2);
    padding: 2rem;
    border-radius: 16px 16px 0 0;
  }

  .blog-detail-card {
    border-radius: 16px;
  }

  .blog-content {
    line-height: 1.8;
    white-space: pre-line;
  }
</style>
