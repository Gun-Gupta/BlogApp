<div class="container py-5">

  <div class="row justify-content-center">
    <div class="col-md-6 col-lg-4">

      <div class="card border-0 shadow-lg login-card">

        <!-- Header -->
        <div class="card-header text-center text-white login-header">
          <h3 class="fw-bold mb-0">🔐 Login</h3>
          <small>Welcome back to MyBlog</small>
        </div>

        <!-- Form -->
        <div class="card-body p-4">

          <form action="/login" method="POST">

            <!-- Email -->
            <div class="mb-3">
              <label class="form-label">Email address</label>
              <input
                type="email"
                name="email"
                class="form-control"
                placeholder="Enter email"
                required>
            </div>

            <!-- Password -->
            <div class="mb-3">
              <label class="form-label">Password</label>
              <input
                type="password"
                name="password"
                class="form-control"
                placeholder="Enter password"
                required>
            </div>

            <!-- Remember -->
            <div class="form-check mb-3">
              <input class="form-check-input" type="checkbox" id="remember">
              <label class="form-check-label" for="remember">
                Remember me
              </label>
            </div>

            <!-- Button -->
            <button type="submit" class="btn btn-primary w-100">
              Login
            </button>

          </form>

        </div>

        <!-- Footer -->
        <div class="card-footer text-center">
          <small>
            Don’t have an account?
            <a href="/signup" class="text-decoration-none">Register</a>
          </small>
        </div>

      </div>

    </div>
  </div>

</div>

<!-- Optional styles -->
<style>
  .login-header {
    background: linear-gradient(135deg, #667eea, #764ba2);
    padding: 1.5rem;
    border-radius: 16px 16px 0 0;
  }

  .login-card {
    border-radius: 16px;
  }
</style>
