<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1" />

  <!-- Tailwind CDN -->
  <script src="https://cdn.tailwindcss.com"></script>

  <title>MyBlog</title>
</head>

<body class="bg-gray-100 font-sans ">

<!-- NAVBAR -->
<nav class="fixed top-0 left-0 w-full bg-slate-900 z-50 shadow">
  <div class="max-w-7xl mx-auto px-6">
    <div class="flex justify-between items-center h-16">
      <a href="/" class="text-white text-xl font-bold">
        MyBlog
      </a>

      <div class="hidden md:flex space-x-6 text-gray-300">
        <a href="/login" class="hover:text-blue-400 transition">About</a>
        <a href="/login" class="hover:text-blue-400 transition">Login</a>
        <a href="/signup" class="hover:text-blue-400 transition">SignUp</a>
      </div>
    </div>
  </div>
</nav>

<!-- HERO SECTION (80% HEIGHT) -->
<section
  class="h-[80vh] pt-16 bg-cover bg-center relative"
  style="background-image: url('https://images.unsplash.com/photo-1481627834876-b7833e8f5570?q=80&w=2128&auto=format&fit=crop');"
>
  <!-- Overlay -->
  <div class="absolute inset-0 bg-black/60 flex items-center justify-center text-center">
    <div class="px-4 animate-fadeIn">
      <h1 class="text-white text-4xl md:text-5xl font-extrabold mb-4">
        Welcome to MyBlog
      </h1>
      <p class="text-gray-200 text-lg md:text-xl mb-6">
        Read. Write. Share your thoughts.
      </p>
      <a
        href="/blog"
        class="inline-block bg-blue-600 hover:bg-blue-700 text-white px-8 py-3 rounded-lg text-lg font-semibold transition transform hover:-translate-y-1 shadow-lg"
      >
        Explore Blogs
      </a>
    </div>
  </div>
</section>

<!-- FOOTER -->
<footer class="bg-slate-900 text-gray-300">
  <div class="max-w-7xl mx-auto px-6 py-12">

    <div class="grid md:grid-cols-3 gap-8">

      <!-- Brand -->
      <div>
        <h5 class="text-white text-xl font-bold mb-3">MyBlog</h5>
        <p class="text-gray-400">
          Read. Write. Share your thoughts with the world.
        </p>
      </div>

      <!-- Quick Links -->
      <div>
        <h6 class="text-white font-semibold mb-3">Quick Links</h6>
        <ul class="space-y-2">
          <li><a href="/" class="hover:text-blue-400 transition">Home</a></li>
          <li><a href="/blog" class="hover:text-blue-400 transition">Blogs</a></li>
          <li><a href="#" class="hover:text-blue-400 transition">About</a></li>
          <li><a href="/login" class="hover:text-blue-400 transition">Login</a></li>
        </ul>
      </div>

      <!-- Social -->
      <div>
        <h6 class="text-white font-semibold mb-3">Connect</h6>
        <p class="text-gray-400 mb-3">Follow us</p>
        <div class="flex space-x-4 text-xl">
          <a href="#" class="hover:scale-125 transition">🌐</a>
          <a href="#" class="hover:scale-125 transition">🐦</a>
          <a href="#" class="hover:scale-125 transition">📸</a>
          <a href="#" class="hover:scale-125 transition">💼</a>
        </div>
      </div>

    </div>

    <!-- COPYRIGHT -->
    <div class="border-t border-gray-700 mt-10 pt-4 text-center text-gray-500">
      © 2026 MyBlog. All rights reserved.
    </div>

  </div>
</footer>

<!-- Animation -->
<style>
  @keyframes fadeIn {
    from {
      opacity: 0;
      transform: translateY(20px);
    }
    to {
      opacity: 1;
      transform: translateY(0);
    }
  }
  .animate-fadeIn {
    animation: fadeIn 1.2s ease-out;
  }
</style>

</body>
</html>
